+@echo off
+rem build-windows.cmd -- the SDK, its host and its tests on Windows (x64), as build.sh is on a Mac.
+rem No CMake, no package manager: clang, llvm-ar and llvm-windres from llvm-mingw, and the SQLite
+rem amalgamation compiled in (python third_party\sqlite\fetch.py puts it in place, checked).
+rem
+rem   build-windows.cmd           build\windows-x64\: libspklib.a, spklib-host.exe, spklib-tests.exe
+rem   build-windows.cmd test      build, then run the tests (SPKLIB_C1_CATALOG for a real catalog)
+rem   build-windows.cmd release   the helper as shipped: optimised, stripped, no timestamp, so the same
+rem                               sources and toolchain give the same bytes;
+rem                               build\windows-x64\release\spklib-host.exe and its .sha256
+rem
+rem The toolchain: %LLVM_MINGW%\bin when LLVM_MINGW is set, else whatever clang is on PATH.
+rem SPKLIB_COMMIT, when set, is appended to the version (0.3.2+<commit>), as build.sh release does.
+rem The tests write only below build\windows-x64\tmp: TMP and TEMP point there while they run.
+setlocal EnableExtensions
+cd /d "%~dp0"
+set "MODE=%~1"
+if "%MODE%"=="" set "MODE=native"
+if not "%MODE%"=="native" if not "%MODE%"=="test" if not "%MODE%"=="release" (
+  echo usage: build-windows.cmd [test^|release] 1>&2
+  exit /b 2
+)
+if defined LLVM_MINGW set "PATH=%LLVM_MINGW%\bin;%PATH%"
+for %%T in (clang clang++ llvm-ar llvm-windres) do (
+  where %%T >nul 2>&1 || (echo build-windows: %%T not found; set LLVM_MINGW to an llvm-mingw folder 1>&2 & exit /b 2)
+)
+if not exist third_party\sqlite\sqlite3.c (
+  echo build-windows: no SQLite amalgamation; run: python third_party\sqlite\fetch.py 1>&2
+  exit /b 2
+)
+
+set /p VERSION=<VERSION
+if defined SPKLIB_COMMIT set "VERSION=%VERSION%+%SPKLIB_COMMIT%"
+set "OUT=build\windows-x64"
+set "OPT=-O2 -g"
+set "STRIP="
+if "%MODE%"=="release" (
+  set "OUT=build\windows-x64\release"
+  set "OPT=-O2 -DNDEBUG"
+  set "STRIP=-s"
+)
+set "OBJ=%OUT%\obj"
+if not exist "%OBJ%" mkdir "%OBJ%"
+set "FIXTURES=%CD:\=/%/tests/fixtures"
+set "SRCDIR=%CD%"
+
+rem No absolute path of this checkout or of the toolchain ends up in the binary (reproducible builds).
+set MAPS="-ffile-prefix-map=%SRCDIR%=."
+if defined LLVM_MINGW set MAPS=%MAPS% "-ffile-prefix-map=%LLVM_MINGW%=llvm-mingw"
+set CFLAGS=-O2 -DNDEBUG -DSQLITE_THREADSAFE=1 -DSQLITE_OMIT_LOAD_EXTENSION -DSQLITE_DEFAULT_MEMSTATUS=0 -D_WIN32_WINNT=0x0A00 %MAPS%
+set CXXFLAGS=-std=c++20 %OPT% -Wall -Wextra -Wno-unused-parameter -Iinclude -Isrc -Ithird_party -Ithird_party/sqlite -D_WIN32_WINNT=0x0A00 "-DSPKLIB_VERSION=\"%VERSION%\"" "-DSPKLIB_FIXTURES=\"%FIXTURES%\"" %MAPS%
+set LDFLAGS=-static %STRIP% -Wl,--no-insert-timestamp -lnormaliz
+
+echo build-windows: spklib %VERSION% (%MODE%) into %OUT%
+clang %CFLAGS% -c third_party\sqlite\sqlite3.c -o %OBJ%\sqlite3.o || goto :fail
+for %%S in (sqlite capture_one library api platform) do (
+  clang++ %CXXFLAGS% -c src\%%S.cpp -o %OBJ%\%%S.o || goto :fail
+)
+rem llvm-ar r replaces members by name; the member set is fixed, so nothing stale survives a rebuild.
+llvm-ar rcs %OUT%\libspklib.a %OBJ%\sqlite3.o %OBJ%\sqlite.o %OBJ%\capture_one.o %OBJ%\library.o %OBJ%\api.o %OBJ%\platform.o || goto :fail
+llvm-windres -I host host\spklib.rc -O coff -o %OBJ%\spklib.res.o || goto :fail
+clang++ %CXXFLAGS% host\main.cpp %OBJ%\spklib.res.o %OUT%\libspklib.a %LDFLAGS% -o %OUT%\spklib-host.exe || goto :fail
+if "%MODE%"=="release" (
+  python -c "import hashlib,sys; print(hashlib.sha256(open(sys.argv[1],'rb').read()).hexdigest() + '  spklib-host.exe')" %OUT%\spklib-host.exe > %OUT%\spklib-host.exe.sha256 || goto :fail
+  type %OUT%\spklib-host.exe.sha256
+  %OUT%\spklib-host.exe --version
+  exit /b 0
+)
+clang++ %CXXFLAGS% tests\tests.cpp %OBJ%\spklib.res.o %OUT%\libspklib.a %LDFLAGS% -o %OUT%\spklib-tests.exe || goto :fail
+echo build-windows: built %OUT%\spklib-host.exe and %OUT%\spklib-tests.exe
+if not "%MODE%"=="test" exit /b 0
+
+if not exist "%OUT%\tmp" mkdir "%OUT%\tmp"
+set "TMP=%CD%\%OUT%\tmp"
+set "TEMP=%CD%\%OUT%\tmp"
+%OUT%\spklib-tests.exe
+exit /b %ERRORLEVEL%
+
+:fail
+echo build-windows: failed 1>&2
+exit /b 1
