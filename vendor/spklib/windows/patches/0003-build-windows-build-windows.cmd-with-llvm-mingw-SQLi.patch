+#!/usr/bin/env python3
+"""Fetch the SQLite amalgamation the Windows build compiles in (build-windows.cmd).
+
+    python third_party/sqlite/fetch.py              download from sqlite.org, check, unpack
+    python third_party/sqlite/fetch.py --zip FILE   check and unpack a zip already downloaded
+
+macOS links the system SQLite (build.sh); Windows has none a program can rely on, so the build
+compiles one pinned release in. The zip is checked against the size and SHA3-256 that
+sqlite.org publishes on https://www.sqlite.org/download.html before anything is unpacked, and
+only sqlite3.c, sqlite3.h and sqlite3ext.h are taken from it. They are not committed
+(.gitignore). SQLite is in the public domain.
+
+Standard library only. Exit status 0 when the three files are in place and match the pin.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import io
+import re
+import sys
+import urllib.request
+import zipfile
+from pathlib import Path
+
+VERSION = "3.54.1"
+NAME = "sqlite-amalgamation-3540100"
+URL = f"https://www.sqlite.org/2026/{NAME}.zip"
+SIZE = 2990966
+SHA3_256 = "92281c86e2957f9b9305890f9ac04204caa7b677cc868dc326d942689df28e30"
+FILES = ("sqlite3.c", "sqlite3.h", "sqlite3ext.h")
+HERE = Path(__file__).resolve().parent
+
+
+def check(data: bytes) -> None:
+    if len(data) != SIZE:
+        raise SystemExit(f"fetch.py: {NAME}.zip is {len(data)} bytes, sqlite.org says {SIZE}; not unpacked")
+    digest = hashlib.sha3_256(data).hexdigest()
+    if digest != SHA3_256:
+        raise SystemExit(f"fetch.py: {NAME}.zip has SHA3-256 {digest}, sqlite.org says {SHA3_256}; not unpacked")
+
+
+def main(argv: list[str]) -> int:
+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    ap.add_argument("--zip", type=Path, help="a downloaded copy of " + NAME + ".zip")
+    args = ap.parse_args(argv)
+
+    if all((HERE / f).is_file() for f in FILES):
+        header = (HERE / "sqlite3.h").read_text(encoding="utf-8", errors="replace")
+        if re.search(r'#define SQLITE_VERSION\s+"' + re.escape(VERSION) + '"', header):
+            print(f"fetch.py: SQLite {VERSION} is already in {HERE}")
+            return 0
+
+    if args.zip:
+        data = args.zip.read_bytes()
+    else:
+        print(f"fetch.py: downloading {URL}")
+        with urllib.request.urlopen(URL, timeout=120) as r:
+            data = r.read()
+    check(data)
+    with zipfile.ZipFile(io.BytesIO(data)) as z:
+        for f in FILES:
+            (HERE / f).write_bytes(z.read(f"{NAME}/{f}"))
+    print(f"fetch.py: SQLite {VERSION} unpacked into {HERE} (SHA3-256 {SHA3_256[:12]}... checked)")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
