diff --git a/tests/c1_acceptance.py b/tests/c1_acceptance.py
new file mode 100644
index 0000000..25a5c99
--- /dev/null
+++ b/tests/c1_acceptance.py
@@ -0,0 +1,368 @@
+#!/usr/bin/env python3
+"""Acceptance of spklib-host against a real Capture One catalog (and session), on any platform.
+
+    python tests/c1_acceptance.py --host build/windows-x64/spklib-host.exe \\
+        --catalog "D:/Pictures/Test.cocatalog" [--session "D:/Pictures/Test Session"] \\
+        --work build/acceptance [--label "Capture One open"] [--json report.json]
+
+What it proves, and how:
+
+1. **Nothing in the Capture One package or session folder changes.** Every file under them is
+   listed with its size, modification time and SHA-256 before anything runs and again at the end;
+   the two lists must be identical (no file changed, added or removed). Run it with Capture One
+   closed for the strict form of this claim: an open Capture One writes its own files.
+2. **The helper reads the catalog completely and correctly.** Through `spklib-host` over stdio,
+   as the app talks to it: `capture_one.probe`, `capture_one.link`, `library.info`,
+   `images.list`, `collections.list`, `locations.list`. Every answer is compared with an
+   independent reading of a byte copy of the same database made here, with Python's own
+   SQLite: image and variant counts, each image's path (resolved again here: ZWINROOT on
+   Windows when Capture One wrote one, else ZMACROOT; backslashes are separators on Windows),
+   that the file exists, the trash flag, each variant's rating and colour tag (from the
+   combined layer), every album's image count, and the folder tree (each folder's parent is
+   the nearest folder above it by path, as Capture One shows it).
+3. **A session is probed, not read.** `capture_one.probe` on a `.cosessiondb` reports its
+   counts, which are compared with the same independent reading; `capture_one.link` on it must
+   answer `unsupported` (sessions wait for SESSION-DESIGN.md §6). A successful probe shows the
+   database is recognised; it is not a complete read of the session.
+
+Writes only inside --work (the mirror library, the oracle's copy, the report). Standard
+library only. Exit status 0 when every check passes.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import shutil
+import sqlite3
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+WINDOWS = os.name == "nt"
+
+
+# --- the package, before and after -------------------------------------------------------------
+
+def census(root: Path) -> dict[str, list]:
+    out: dict[str, list] = {}
+    for dirpath, dirnames, filenames in os.walk(root):
+        dirnames.sort()
+        for name in sorted(filenames):
+            p = Path(dirpath) / name
+            st = p.stat()
+            h = hashlib.sha256()
+            with open(p, "rb") as f:
+                for chunk in iter(lambda: f.read(1 << 20), b""):
+                    h.update(chunk)
+            out[p.relative_to(root).as_posix()] = [st.st_size, st.st_mtime_ns, h.hexdigest()]
+    return out
+
+
+def census_diff(before: dict, after: dict) -> list[str]:
+    diffs = []
+    for k in sorted(set(before) | set(after)):
+        if k not in after:
+            diffs.append(f"removed: {k}")
+        elif k not in before:
+            diffs.append(f"added: {k}")
+        elif before[k] != after[k]:
+            diffs.append(f"changed: {k} {before[k]} -> {after[k]}")
+    return diffs
+
+
+# --- the helper over stdio ---------------------------------------------------------------------
+
+class Host:
+    def __init__(self, exe: Path, store: Path):
+        self.p = subprocess.Popen([str(exe), "--store", str(store)], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
+                                  stderr=subprocess.PIPE)
+        ready = json.loads(self.p.stdout.readline())
+        if ready.get("event") != "ready":
+            raise RuntimeError(f"no ready line: {ready}")
+        self.ready = ready
+        self.n = 0
+
+    def call(self, method: str, params: dict | None = None) -> tuple[bool, dict]:
+        self.n += 1
+        line = json.dumps({"id": self.n, "method": method, "params": params or {}}, ensure_ascii=False) + "\n"
+        self.p.stdin.write(line.encode("utf-8"))
+        self.p.stdin.flush()
+        raw = self.p.stdout.readline()
+        if not raw.endswith(b"\n") or raw.endswith(b"\r\n"):
+            raise RuntimeError(f"{method}: a reply must end in a bare \\n: {raw[-20:]!r}")
+        reply = json.loads(raw)
+        if reply.get("id") != self.n:
+            raise RuntimeError(f"{method}: reply id {reply.get('id')} for request {self.n}")
+        return ("result" in reply), reply.get("result", reply.get("error"))
+
+    def close(self) -> str:
+        try:
+            self.call("host.shutdown")
+        except Exception:
+            pass
+        try:
+            self.p.stdin.close()
+        except Exception:
+            pass
+        self.p.wait(timeout=30)
+        return self.p.stderr.read().decode("utf-8", "replace")
+
+
+# --- the independent reading -------------------------------------------------------------------
+
+def find_db(path: Path, suffix: str) -> Path:
+    if path.is_file():
+        return path
+    found = [p for p in path.iterdir() if p.is_file() and p.suffix == suffix]
+    if len(found) != 1:
+        raise SystemExit(f"expected one {suffix} in {path}, found {len(found)}")
+    return found[0]
+
+
+def byte_copy(src: Path, dst: Path) -> None:
+    with open(src, "rb") as i, open(dst, "wb") as o:
+        shutil.copyfileobj(i, o, 1 << 20)
+
+
+def open_copy(path: Path) -> sqlite3.Connection:
+    return sqlite3.connect(path.resolve().as_uri() + "?mode=ro&immutable=1", uri=True)
+
+
+def spelled(p: str) -> str:
+    """A path as spklib returns it: '/' between components on Windows."""
+    return p.replace("\\", "/") if WINDOWS else p
+
+
+def oracle_root(mac: str | None, win: str | None) -> str:
+    if WINDOWS and win and win.strip():
+        r = win.replace("\\", "/")
+        return r + "/" if len(r) == 2 and r[1] == ":" else r
+    return mac or ""
+
+
+def oracle_join(base: str, rel: str | None) -> str:
+    r = (rel or "").replace("\\", "/") if WINDOWS else (rel or "")
+    r = r.lstrip("/")
+    b = base
+    while len(b) > 1 and b.endswith("/") and not (WINDOWS and len(b) == 3 and b[1] == ":"):
+        b = b[:-1]
+    if not r:
+        return b
+    return b + r if b.endswith("/") else b + "/" + r
+
+
+def layer_of(db: sqlite3.Connection) -> str:
+    """The layer whose metadata Capture One shows: the combined one, else the adjustment layer
+    (docs/CAPTURE-ONE-CATALOG.md)."""
+    cols = {r[1] for r in db.execute("PRAGMA table_info(ZVARIANT)")}
+    return "COALESCE(v.ZCOMBINEDSETTINGS, v.ZADJUSTMENTLAYER)" if "ZADJUSTMENTLAYER" in cols else "v.ZCOMBINEDSETTINGS"
+
+
+def oracle_catalog(db: sqlite3.Connection, package: str) -> dict:
+    q = lambda sql, *a: db.execute(sql, a).fetchall()
+    entity = dict(q("SELECT Z_ENT, ZNAME FROM ZENTITIES"))
+    loc = {}
+    for pk, rel_flag, mac, win, rel in q("SELECT Z_PK, ZISRELATIVE, ZMACROOT, ZWINROOT, ZRELATIVEPATH FROM ZPATHLOCATION"):
+        loc[pk] = oracle_join(package if rel_flag else oracle_root(mac, win), rel)
+    images = {}
+    for uuid, name, l, trashed in q("SELECT ZIMAGEUUID, ZIMAGEFILENAME, ZIMAGELOCATION, ZISTRASHED FROM ZIMAGE"):
+        images[uuid] = {"path": oracle_join(loc[l], name), "trashed": bool(trashed)}
+    variants = {}
+    for vu, iu, rating, color in q(
+            "SELECT v.ZVARIANTUUID, i.ZIMAGEUUID, COALESCE(m.ZBASIC_RATING, 0), COALESCE(m.ZCOLOR_TAG_INDEX, 0)"
+            " FROM ZVARIANT v JOIN ZIMAGE i ON i.Z_PK = v.ZIMAGE"
+            f" LEFT JOIN ZVARIANTLAYER l ON l.Z_PK = {layer_of(db)} LEFT JOIN ZVARIANTMETADATA m ON m.ZLAYER = l.Z_PK"):
+        variants[vu] = {"image": iu, "rating": rating, "color_tag": color or None}
+    cols = {}
+    for pk, ent, cu, name, parent, floc in q("SELECT Z_PK, Z_ENT, ZUUID, ZNAME, ZPARENT, ZFOLDERLOCATION FROM ZCOLLECTION"):
+        cols[pk] = {"entity": entity.get(ent, str(ent)), "uuid": cu, "name": name, "parent": parent,
+                    "folder": loc.get(floc) if floc else None}
+    albums = {}
+    for cu, n in q("SELECT c.ZUUID, count(i.Z_PK) FROM ZCOLLECTION c JOIN ZENTITIES e ON e.Z_ENT = c.Z_ENT"
+                   " LEFT JOIN ZIMAGEINCOLLECTION ic ON ic.ZCOLLECTION = c.Z_PK"
+                   " LEFT JOIN ZIMAGE i ON i.Z_PK = ic.ZIMAGE AND i.ZISTRASHED = 0"
+                   " WHERE e.ZNAME IN ('AlbumCollection') GROUP BY c.Z_PK"):
+        albums[cu] = n
+    # The folder tree as Capture One shows it: a folder hangs from the nearest folder above it.
+    folders = {c["uuid"]: c["folder"] for c in cols.values() if c["entity"] == "CatalogFolderCollection" and c["folder"]}
+    folder_parent = {}
+    for u, d in folders.items():
+        best, parent = -1, None
+        for v, e in folders.items():
+            if v != u and (d.startswith(e) if e.endswith("/") else d.startswith(e + "/")) and len(e) > best:
+                best, parent = len(e), v
+        folder_parent[u] = parent
+    return {"locations": loc, "images": images, "variants": variants, "collections": cols, "albums": albums,
+            "folders": folders, "folder_parent": folder_parent,
+            "format": q("SELECT ZFORMAT FROM ZVERSIONINFO ORDER BY ZVERSION DESC, Z_PK DESC LIMIT 1")[0][0],
+            "document_uuid": q("SELECT ZDOCUMENTUUID FROM ZDOCUMENTCONTENT LIMIT 1")[0][0]}
+
+
+def oracle_counts(db: sqlite3.Connection) -> dict:
+    q = lambda sql: db.execute(sql).fetchone()[0]
+    lay = layer_of(db)
+    rated = q("SELECT count(*) FROM ZVARIANT v LEFT JOIN ZVARIANTLAYER l ON l.Z_PK = " + lay +
+              " LEFT JOIN ZVARIANTMETADATA m ON m.ZLAYER = l.Z_PK WHERE COALESCE(m.ZBASIC_RATING, 0) > 0")
+    tagged = q("SELECT count(*) FROM ZVARIANT v LEFT JOIN ZVARIANTLAYER l ON l.Z_PK = " + lay +
+               " LEFT JOIN ZVARIANTMETADATA m ON m.ZLAYER = l.Z_PK WHERE COALESCE(m.ZCOLOR_TAG_INDEX, 0) > 0")
+    return {"images": q("SELECT count(*) FROM ZIMAGE"), "variants": q("SELECT count(*) FROM ZVARIANT"),
+            "locations": q("SELECT count(*) FROM ZPATHLOCATION"), "collections": q("SELECT count(*) FROM ZCOLLECTION"),
+            "trashed": q("SELECT count(*) FROM ZIMAGE WHERE ZISTRASHED = 1"),
+            "inside_catalog": q("SELECT count(*) FROM ZIMAGE WHERE ZISINSIDECATALOG = 1"),
+            "rated": rated, "color_tagged": tagged}
+
+
+# --- the run -----------------------------------------------------------------------------------
+
+class Checks:
+    def __init__(self):
+        self.items: list[dict] = []
+
+    def add(self, name: str, ok: bool, detail="") -> None:
+        self.items.append({"check": name, "ok": bool(ok), "detail": detail})
+        print(("PASS " if ok else "FAIL ") + name + (f" -- {detail}" if detail and not ok else ""))
+
+    def ok(self) -> bool:
+        return all(i["ok"] for i in self.items)
+
+
+def main(argv: list[str]) -> int:
+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    ap.add_argument("--host", type=Path, required=True)
+    ap.add_argument("--catalog", type=Path, required=True)
+    ap.add_argument("--session", type=Path)
+    ap.add_argument("--work", type=Path, required=True)
+    ap.add_argument("--label", default="")
+    ap.add_argument("--json", type=Path)
+    a = ap.parse_args(argv)
+    try:
+        sys.stdout.reconfigure(encoding="utf-8", errors="replace")
+    except (AttributeError, ValueError):
+        pass
+
+    work = a.work.resolve()
+    if work.exists():
+        raise SystemExit(f"--work {work} exists; give a new folder (nothing is deleted here)")
+    work.mkdir(parents=True)
+    catalog = a.catalog.resolve()
+    session = a.session.resolve() if a.session else None
+    checks = Checks()
+    report: dict = {"label": a.label, "time": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "platform": sys.platform,
+                    "catalog": str(catalog), "session": str(session) if session else None}
+
+    roots = [catalog] + ([session] if session else [])
+    t0 = time.time()
+    before = {str(r): census(r) for r in roots}
+    report["census_files"] = {k: len(v) for k, v in before.items()}
+    report["census_seconds"] = round(time.time() - t0, 2)
+
+    host = Host(a.host, work / "store")
+    report["host"] = host.ready
+    ok, ver = host.call("sdk.version")
+    report["sdk"] = ver
+
+    # Catalog: probe, then the independent reading of a byte copy.
+    cat_db = find_db(catalog, ".cocatalogdb")
+    ok, probe = host.call("capture_one.probe", {"path": str(catalog)})
+    report["catalog_probe"] = probe
