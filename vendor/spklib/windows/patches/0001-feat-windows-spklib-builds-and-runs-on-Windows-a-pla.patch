+int64_t copy_database_file(const std::string& from_s, const std::string& to_s, int64_t lock_byte_offset) {
+#ifdef _WIN32
+    // Windows locks are mandatory: while Capture One holds SQLite's RESERVED,
+    // PENDING or EXCLUSIVE lock, a ReadFile over those bytes fails with
+    // ERROR_LOCK_VIOLATION. They sit on the lock-byte page, the page that
+    // starts at 1 GiB, which SQLite never reads or writes. So that page is
+    // written as zeros and never read; every other byte is copied.
+    const fs::path from(from_s), to(to_s);
+    HANDLE h = CreateFileW(from.wstring().c_str(), GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                           nullptr, OPEN_EXISTING, FILE_FLAG_SEQUENTIAL_SCAN, nullptr);
+    if (h == INVALID_HANDLE_VALUE) throw std::runtime_error("cannot read " + from_s);
+    struct Closer { HANDLE h; ~Closer() { CloseHandle(h); } } closer{h};
+    LARGE_INTEGER size{};
+    if (!GetFileSizeEx(h, &size)) throw std::runtime_error("cannot size " + from_s);
+    std::ofstream out(to, std::ios::binary | std::ios::trunc);
+    if (!out) throw std::runtime_error("cannot write " + to_s);
+    std::vector<char> buf(1 << 20);
+    auto read_at = [&](int64_t off, DWORD want) -> DWORD {
+        OVERLAPPED ov{};
+        ov.Offset = DWORD(uint64_t(off) & 0xFFFFFFFFu);
+        ov.OffsetHigh = DWORD(uint64_t(off) >> 32);
+        DWORD got = 0;
+        if (!ReadFile(h, buf.data(), want, &got, &ov)) {
+            DWORD e = GetLastError();
+            if (e == ERROR_HANDLE_EOF) return 0;
+            throw std::runtime_error("cannot read " + from_s + " at " + std::to_string(off) + " (Windows error " +
+                                     std::to_string(e) + ")");
+        }
+        return got;
+    };
+    // The page size, from the header: bytes 16-17, big-endian, 1 meaning 65536.
+    int64_t page = 65536;
+    if (read_at(0, 100) == 100 && std::string(buf.data(), 16) == std::string("SQLite format 3\0", 16)) {
+        int64_t p = (int64_t(uint8_t(buf[16])) << 8) | uint8_t(buf[17]);
+        page = p == 1 ? 65536 : p >= 512 ? p : 65536;
+    }
+    int64_t lock_lo = -1, lock_hi = -1;
+    if (lock_byte_offset >= 0 && size.QuadPart > lock_byte_offset) {
+        lock_lo = lock_byte_offset;
+        lock_hi = std::min<int64_t>(lock_byte_offset + page, size.QuadPart);
+    }
+    int64_t off = 0;
+    for (;;) {
+        if (lock_lo >= 0 && off >= lock_lo && off < lock_hi) {
+            std::vector<char> zeros(size_t(lock_hi - off), '\0');
+            out.write(zeros.data(), std::streamsize(zeros.size()));
+            off = lock_hi;
+            continue;
+        }
+        int64_t want = int64_t(buf.size());
+        if (lock_lo >= 0 && off < lock_lo) want = std::min(want, lock_lo - off);
+        DWORD got = read_at(off, DWORD(want));
+        if (got == 0) break;
+        out.write(buf.data(), got);
+        off += got;
+    }
+    out.flush();
+    if (!out) throw std::runtime_error("short write to " + to_s);
+    return off;
+#else
+    (void)lock_byte_offset;
+    return copy_bytes(fs::path(from_s), fs::path(to_s));
+#endif
+}
