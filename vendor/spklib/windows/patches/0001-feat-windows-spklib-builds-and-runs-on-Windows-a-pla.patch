+// --- the platform layer, and what a Windows catalog looks like ------------------------------------
+
+static void platform_port() {
+    namespace pf = spklib::platform;
+
+    run("paths: roots, trailing separators, separators", [] {
+        CHECK_EQ(pf::root_length("/"), size_t(1));
+        CHECK_EQ(pf::root_length("/Volumes/X"), size_t(1));
+        CHECK_EQ(pf::root_length("relative/x"), size_t(0));
+        CHECK_EQ(pf::strip_trailing_separators("/"), std::string("/"));
+        CHECK_EQ(pf::strip_trailing_separators("/a/b//"), std::string("/a/b"));
+        CHECK_EQ(pf::strip_trailing_separators("/Volumes/NIKON Z 8   "), std::string("/Volumes/NIKON Z 8   "));
+#ifdef _WIN32
+        CHECK_EQ(pf::root_length("C:/"), size_t(3));
+        CHECK_EQ(pf::root_length("C:/Users/x"), size_t(3));
+        CHECK_EQ(pf::root_length("//server/share/Photos"), size_t(15));
+        CHECK_EQ(pf::strip_trailing_separators("C:/"), std::string("C:/"));
+        CHECK_EQ(pf::strip_trailing_separators("C:/Photos/"), std::string("C:/Photos"));
+        CHECK_EQ(pf::to_spklib_separators("Users\\Sizhi\\Desktop"), std::string("Users/Sizhi/Desktop"));
+        CHECK_EQ(pf::path_string(fs::path("C:\\Users\\x\\A.NEF")), std::string("C:/Users/x/A.NEF"));
+        CHECK(pf::utf8_code_page());  // the manifest is embedded
+#else
+        CHECK_EQ(pf::to_spklib_separators("a\\b"), std::string("a\\b"));  // a legal character here
+#endif
+    });
+
+    run("a Capture One location resolves with this platform's root", [] {
+        spklib::c1::PathLocation win;  // as Capture One 16.6 for Windows writes it
+        win.win_root = "C:\\";
+        win.mac_root = "";
+        win.relative_path = spklib::platform::to_spklib_separators("Users\\me\\Pictures\\Day 1");
+        win.root = spklib::c1::platform_root(win);
+        spklib::c1::PathLocation mac;  // as Capture One for Mac writes it
+        mac.mac_root = "/Volumes/NIKON Z 8   ";
+        mac.relative_path = "DCIM/100NZ8";
+        mac.root = spklib::c1::platform_root(mac);
+        spklib::c1::PathLocation drive_root = win;
+        drive_root.relative_path = "";
+#ifdef _WIN32
+        CHECK_EQ(spklib::c1::resolve(win, "C:/x.cocatalog"), std::string("C:/Users/me/Pictures/Day 1"));
+        CHECK_EQ(spklib::c1::resolve(drive_root, "C:/x.cocatalog"), std::string("C:/"));
+        // A catalog made on a Mac keeps its Mac roots: offline here, never guessed.
+        CHECK_EQ(spklib::c1::resolve(mac, "C:/x.cocatalog"), std::string("/Volumes/NIKON Z 8   /DCIM/100NZ8"));
+#else
+        // Off Windows ZMACROOT is the root, exactly as before the port.
+        CHECK_EQ(spklib::c1::resolve(mac, "/x.cocatalog"), std::string("/Volumes/NIKON Z 8   /DCIM/100NZ8"));
+        CHECK_EQ(win.root, std::string(""));
