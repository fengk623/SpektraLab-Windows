+    });
+
+    run("the snapshot copy: every byte, and on Windows the lock-byte page as zeros", [] {
+        fs::path root = tmpdir("lockpage");
+        std::string src = (root / "src.db").generic_string(), dst = (root / "dst.db").generic_string();
+        {
+            Db d(src, Db::Mode::Create);
+            d.exec("PRAGMA page_size = 4096");
+            d.exec("CREATE TABLE t(x BLOB)");
+            for (int i = 0; i < 8; ++i) d.exec("INSERT INTO t VALUES (randomblob(3000))");
+        }
+        std::string before = read_file(src);
+        CHECK(before.size() >= 5 * 4096);
+        const int64_t lock_at = 8192;  // stands in for 1 GiB
+#ifdef _WIN32
+        // Hold the page the way Capture One's SQLite would hold its lock bytes:
+        // an exclusive lock, which makes every other handle's read fail.
+        HANDLE h = CreateFileW(fs::path(src).wstring().c_str(), GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE,
+                               nullptr, OPEN_EXISTING, 0, nullptr);
+        CHECK(h != INVALID_HANDLE_VALUE);
+        OVERLAPPED ov{};
+        ov.Offset = DWORD(lock_at);
+        CHECK(LockFileEx(h, LOCKFILE_EXCLUSIVE_LOCK | LOCKFILE_FAIL_IMMEDIATELY, 0, 4096, 0, &ov) != 0);
+        {
+            // The lock is real: an ordinary read of those bytes fails.
+            std::ifstream probe(fs::path(src), std::ios::binary);
+            std::string all{std::istreambuf_iterator<char>(probe), std::istreambuf_iterator<char>()};
+            CHECK(all.size() < before.size());
+        }
+#endif
+        int64_t n = spklib::c1::detail::copy_database_file(src, dst, lock_at);
+#ifdef _WIN32
+        UnlockFileEx(h, 0, 4096, 0, &ov);
+        CloseHandle(h);
+#endif
+        std::string after = read_file(dst);
+        CHECK_EQ(n, int64_t(before.size()));
+        CHECK_EQ(after.size(), before.size());
+#ifdef _WIN32
+        CHECK(after.compare(0, size_t(lock_at), before, 0, size_t(lock_at)) == 0);
+        CHECK(after.substr(size_t(lock_at), 4096) == std::string(4096, '\0'));
+        CHECK(after.compare(size_t(lock_at) + 4096, std::string::npos, before, size_t(lock_at) + 4096, std::string::npos) == 0);
