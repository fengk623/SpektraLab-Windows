@@ -0,0 +1,239 @@
+#include "platform.hpp"
+
+#include <algorithm>
+#include <cctype>
+#include <cerrno>
+#include <cstdio>
+#include <cstring>
+
+#ifdef _WIN32
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#ifdef _MSC_VER
+#pragma comment(lib, "normaliz.lib")
+#endif
+#else
+#include <stdio.h>
+#include <sys/stat.h>
+#endif
+
+#ifdef __APPLE__
+#include <CoreFoundation/CoreFoundation.h>
+#endif
+
+namespace fs = std::filesystem;
+
+namespace spklib::platform {
+
+#ifdef _WIN32
+namespace {
+
+std::wstring widen(const std::string& s) {
+    if (s.empty()) return std::wstring();
+    int n = MultiByteToWideChar(CP_UTF8, 0, s.data(), int(s.size()), nullptr, 0);
+    std::wstring w(size_t(n), L'\0');
+    MultiByteToWideChar(CP_UTF8, 0, s.data(), int(s.size()), w.data(), n);
+    return w;
+}
+
+std::string narrow(const wchar_t* w, int len) {
+    if (len <= 0) return std::string();
+    int n = WideCharToMultiByte(CP_UTF8, 0, w, len, nullptr, 0, nullptr, nullptr);
+    std::string s(size_t(n), '\0');
+    WideCharToMultiByte(CP_UTF8, 0, w, len, s.data(), n, nullptr, nullptr);
+    return s;
+}
+
+std::string last_error_message(DWORD e) {
+    wchar_t* buf = nullptr;
+    DWORD n = FormatMessageW(FORMAT_MESSAGE_ALLOCATE_BUFFER | FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_IGNORE_INSERTS,
+                             nullptr, e, 0, reinterpret_cast<wchar_t*>(&buf), 0, nullptr);
+    std::string out = n ? narrow(buf, int(n)) : "error " + std::to_string(e);
+    if (buf) LocalFree(buf);
+    while (!out.empty() && (out.back() == '\n' || out.back() == '\r' || out.back() == ' ')) out.pop_back();
+    return out;
+}
+
+}  // namespace
+#endif
+
+// --- time --------------------------------------------------------------------------------
+
+// MinGW declares gmtime_s and localtime_s only with its "secure API" on; the
+// Windows CRT keeps gmtime's and localtime's result per thread, so the plain
+// calls are thread-safe there.
+void utc_tm(time_t t, std::tm* out) {
+#if defined(_MSC_VER)
+    gmtime_s(out, &t);
+#elif defined(_WIN32)
+    if (const std::tm* r = std::gmtime(&t)) *out = *r;
+#else
+    gmtime_r(&t, out);
+#endif
+}
+
+void local_tm(time_t t, std::tm* out) {
+#if defined(_MSC_VER)
+    localtime_s(out, &t);
+#elif defined(_WIN32)
+    if (const std::tm* r = std::localtime(&t)) *out = *r;
+#else
+    localtime_r(&t, out);
+#endif
+}
+
+time_t utc_time(std::tm* tm) {
+#ifdef _WIN32
+    return _mkgmtime(tm);
+#else
+    return timegm(tm);
+#endif
+}
+
+// --- files -------------------------------------------------------------------------------
+
+bool file_stat(const std::string& path, FileStat* out) {
+#ifdef _WIN32
+    WIN32_FILE_ATTRIBUTE_DATA a{};
+    if (!GetFileAttributesExW(widen(path).c_str(), GetFileExInfoStandard, &a)) return false;
+    if (out) {
+        out->size = (int64_t(a.nFileSizeHigh) << 32) | int64_t(a.nFileSizeLow);
+        // FILETIME: 100 ns ticks since 1601-01-01 UTC.
+        int64_t ticks = (int64_t(a.ftLastWriteTime.dwHighDateTime) << 32) | int64_t(a.ftLastWriteTime.dwLowDateTime);
+        out->mtime_ns = (ticks - 116444736000000000LL) * 100;
+    }
+    return true;
+#else
+    struct stat st {};
+    if (::stat(path.c_str(), &st) != 0) return false;
+    if (out) {
+        out->size = int64_t(st.st_size);
+#ifdef __APPLE__
+        out->mtime_ns = int64_t(st.st_mtimespec.tv_sec) * 1'000'000'000 + st.st_mtimespec.tv_nsec;
+#else
+        out->mtime_ns = int64_t(st.st_mtim.tv_sec) * 1'000'000'000 + st.st_mtim.tv_nsec;
+#endif
+    }
+    return true;
+#endif
+}
+
+int rename_no_replace(const std::string& from, const std::string& to, std::string* message) {
+#ifdef _WIN32
+    if (MoveFileExW(widen(from).c_str(), widen(to).c_str(), 0)) return 0;
+    DWORD e = GetLastError();
+    if (message) *message = last_error_message(e);
+    switch (e) {
+    case ERROR_ALREADY_EXISTS:
+    case ERROR_FILE_EXISTS: return EEXIST;
+    case ERROR_NOT_SAME_DEVICE: return EXDEV;
+    case ERROR_FILE_NOT_FOUND:
+    case ERROR_PATH_NOT_FOUND: return ENOENT;
+    default: return EIO;
+    }
+#else
+#ifdef __APPLE__
+    int rc = ::renamex_np(from.c_str(), to.c_str(), RENAME_EXCL);
+#else
+    int rc = ::rename(from.c_str(), to.c_str());
+#endif
+    if (rc == 0) return 0;
+    int e = errno;
+    if (message) *message = std::strerror(e);
+    return e;
+#endif
+}
+
+// --- text and paths ----------------------------------------------------------------------
+
+std::string nfc(const std::string& s) {
+    bool ascii = std::all_of(s.begin(), s.end(), [](char c) { return static_cast<unsigned char>(c) < 0x80; });
+    if (ascii) return s;
+#if defined(__APPLE__)
+    CFStringRef in = CFStringCreateWithBytes(nullptr, reinterpret_cast<const UInt8*>(s.data()), CFIndex(s.size()),
+                                             kCFStringEncodingUTF8, false);
+    if (!in) return s;
+    CFMutableStringRef m = CFStringCreateMutableCopy(nullptr, 0, in);
+    CFStringNormalize(m, kCFStringNormalizationFormC);
+    CFIndex len = CFStringGetLength(m), used = 0;
+    CFStringGetBytes(m, CFRangeMake(0, len), kCFStringEncodingUTF8, 0, false, nullptr, 0, &used);
+    std::string out(size_t(used), '\0');
+    CFStringGetBytes(m, CFRangeMake(0, len), kCFStringEncodingUTF8, 0, false,
+                     reinterpret_cast<UInt8*>(out.data()), used, &used);
+    CFRelease(m);
+    CFRelease(in);
+    return out;
+#elif defined(_WIN32)
+    std::wstring w = widen(s);
+    int need = NormalizeString(NormalizationC, w.c_str(), int(w.size()), nullptr, 0);
+    // The estimate can be short; NormalizeString says so and gives a better one.
+    for (int attempt = 0; attempt < 4 && need > 0; ++attempt) {
+        std::wstring out(size_t(need), L'\0');
+        int got = NormalizeString(NormalizationC, w.c_str(), int(w.size()), out.data(), need);
+        if (got > 0) return narrow(out.data(), got);
+        if (GetLastError() != ERROR_INSUFFICIENT_BUFFER) break;
+        need = -got;
+    }
+    return s;  // invalid UTF-16 or no memory: compare as given
+#else
+    return s;
+#endif
+}
+
+std::string path_string(const fs::path& p) {
+#ifdef _WIN32
+    return p.generic_string();
+#else
+    return p.string();
+#endif
+}
+
+size_t root_length(const std::string& path) {
+#ifdef _WIN32
+    auto sep = [](char c) { return c == '/' || c == '\\'; };
+    // C:/
+    if (path.size() >= 3 && std::isalpha(static_cast<unsigned char>(path[0])) && path[1] == ':' && sep(path[2])) return 3;
+    // //server/share/ (and \\?\C:\ style prefixes, which are read the same way)
+    if (path.size() >= 2 && sep(path[0]) && sep(path[1])) {
+        size_t server_end = path.find_first_of("/\\", 2);
+        if (server_end == std::string::npos) return path.size();
+        size_t share_end = path.find_first_of("/\\", server_end + 1);
+        if (share_end == std::string::npos) return path.size();
+        return share_end + 1;
+    }
+    if (!path.empty() && sep(path[0])) return 1;
+    return 0;
+#else
+    return !path.empty() && path[0] == '/' ? 1 : 0;
+#endif
+}
+
+std::string strip_trailing_separators(std::string path) {
+    size_t keep = std::max<size_t>(root_length(path), 1);
+    while (path.size() > keep && path.back() == '/') path.pop_back();
+    return path;
+}
+
+std::string to_spklib_separators(std::string path) {
+#ifdef _WIN32
+    std::replace(path.begin(), path.end(), '\\', '/');
+#endif
+    return path;
+}
+
+// --- process -----------------------------------------------------------------------------
+
+bool utf8_code_page() {
+#ifdef _WIN32
+    return GetACP() == CP_UTF8;
+#else
+    return true;
+#endif
+}
+
+}  // namespace spklib::platform
