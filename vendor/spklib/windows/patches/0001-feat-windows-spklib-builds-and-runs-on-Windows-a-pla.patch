+// platform.hpp -- the few things that differ between macOS, Linux and
+// Windows: file times, the C time functions, a rename that never replaces,
+// Unicode NFC, and how a path is spelled as a string.
+//
+// Paths. spklib keeps every path as a UTF-8 string with '/' between
+// components. On macOS and Linux that is the native spelling and nothing here
+// changes it. On Windows it is the "generic" form of the native path:
+// `C:/Users/me/Pictures/A.NEF`, `//server/share/Photos`. Windows accepts '/'
+// in every API spklib calls (std::filesystem, SQLite, the C runtime), so the
+// strings are used as they are; only their root differs from POSIX ("C:/"
+// rather than "/"), which `root_length` and `split_root` know about.
+//
+// UTF-8 on Windows. The narrow-string APIs (std::filesystem::path from a
+// std::string, std::ifstream, argv) use the process's active code page. The
+// host and the tests embed a manifest that makes it UTF-8 (Windows 10 1903 or
+// later); `spklib_create` refuses to start when it is not, rather than
+// mangle a non-ASCII path (`utf8_code_page`).
+
+#pragma once
+
+#include <cstdint>
+#include <ctime>
+#include <filesystem>
+#include <string>
+
+namespace spklib::platform {
+
+// --- time --------------------------------------------------------------------------------
+
+void utc_tm(time_t t, std::tm* out);      ///< gmtime_r
+void local_tm(time_t t, std::tm* out);    ///< localtime_r
+time_t utc_time(std::tm* tm);             ///< timegm
+
+// --- files -------------------------------------------------------------------------------
+
+struct FileStat {
+    int64_t size = 0;
+    int64_t mtime_ns = 0;  ///< nanoseconds since 1970-01-01 UTC; 100 ns resolution on NTFS
+};
+
+/// stat(2), following links. False when nothing is at `path`.
+bool file_stat(const std::string& path, FileStat* out = nullptr);
+
+/// Rename `from` to `to` unless something is already at `to`. Returns 0, or
+/// an errno value: EEXIST (something is at `to`), EXDEV (another volume),
+/// ENOENT (no `from`), or another for anything else (`message` says what).
+/// macOS: renamex_np(RENAME_EXCL). Windows: MoveFileExW without
+/// MOVEFILE_REPLACE_EXISTING or MOVEFILE_COPY_ALLOWED. Linux: rename(2),
+/// which replaces -- as before this file existed; Linux is not shipped.
+int rename_no_replace(const std::string& from, const std::string& to, std::string* message);
+
+// --- text and paths ----------------------------------------------------------------------
+
+/// Unicode NFC. CoreFoundation on Apple, NormalizeString on Windows, the
+/// identity elsewhere (docs/DESIGN.md, open items).
+std::string nfc(const std::string& s);
+
+/// A path as spklib stores and returns it: `p.string()` on POSIX,
+/// `p.generic_string()` on Windows.
+std::string path_string(const std::filesystem::path& p);
+
+/// Length of the root of an absolute path in spklib's spelling: "/" -> 1;
+/// on Windows also "C:/" -> 3 and "//server/share/" -> its length. 0 when the
+/// path is not absolute.
+size_t root_length(const std::string& path);
+
+/// `path` without trailing '/', but never shorter than its root ("/", "C:/").
+std::string strip_trailing_separators(std::string path);
+
+/// Windows only: `\` -> `/`. Elsewhere the string is returned as it is (a
+/// backslash is a legal character in a macOS or Linux file name).
+std::string to_spklib_separators(std::string path);
+
+// --- process -----------------------------------------------------------------------------
+
+/// Windows: true when the active code page is UTF-8 (65001). Elsewhere true.
+bool utf8_code_page();
+
+}  // namespace spklib::platform
