@@ -50,6 +50,18 @@ using spklib::Json;
 // --- harness ---------------------------------------------------------------------------------
 
 static int g_failed = 0, g_passed = 0;
+
+// An album holds the images ZIMAGEINCOLLECTION lists; a folder holds the images whose location it is.
+// (A Mac catalog also lists folder members in ZIMAGEINCOLLECTION, and the two agree; Capture One
+// 16.6 for Windows lists none, so the location is the one reading that holds for both.) Trashed
+// images are not counted, as Capture One does not show them.
+static const char* kC1CollectionCounts =
+    "SELECT c.ZUUID, CASE WHEN e.ZNAME = 'CatalogFolderCollection'"
+    " THEN (SELECT count(*) FROM ZIMAGE i WHERE i.ZIMAGELOCATION = c.ZFOLDERLOCATION AND i.ZISTRASHED = 0)"
+    " ELSE (SELECT count(*) FROM ZIMAGEINCOLLECTION ic JOIN ZIMAGE i ON i.Z_PK = ic.ZIMAGE AND i.ZISTRASHED = 0"
+    " WHERE ic.ZCOLLECTION = c.Z_PK) END"
+    " FROM ZCOLLECTION c JOIN ZENTITIES e ON e.Z_ENT = c.Z_ENT"
+    " WHERE e.ZNAME IN ('AlbumCollection', 'CatalogFolderCollection')";
 static std::string g_test;
 
